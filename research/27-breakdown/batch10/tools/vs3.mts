import { readFileSync } from 'node:fs'
import { readyPlan } from '/home/user/Naparnik-Site-ADHD/lib/ai/agents/breakdown'
const G = [['Найти', 'Вызвать', 'Выбрать', 'Подобрать', 'Поискать'], ['Оформить', 'Открыть', 'Сделать', 'Получить', 'Завести'], ['Отнести', 'Отправить', 'Сдать', 'Отвезти', 'Отдать'], ['Подготовить', 'Собрать', 'Устроить', 'Организовать', 'Подготовиться к'], ['Начать', 'Завести', 'Взяться за'], ['Получить', 'Взять', 'Забрать'], ['Обновить', 'Поменять', 'Сменить', 'Заменить'], ['Положить', 'Внести', 'Пополнить'], ['Научиться', 'Освоить', 'Выучить', 'Изучить'], ['Позвонить', 'Написать', 'Связаться с'], ['Перевести', 'Перенести', 'Перевестись'], ['Отменить', 'Отключить', 'Отписаться от'], ['Перестать', 'Бросить', 'Не'], ['Поговорить о', 'Попросить', 'Обсудить'], ['Настроить', 'Включить', 'Подключить', 'Установить'], ['Отметить', 'Отпраздновать'], ['Подать', 'Отправить', 'Передать'], ['Повесить', 'Прибить'], ['Поиграть в', 'Сыграть в'], ['Пожарить', 'Приготовить', 'Сделать'], ['Погладить', 'Отпарить'], ['Позаниматься', 'Сделать'], ['Подписать', 'Заключить'], ['Подтянуть', 'Повторить', 'Выучить']]
const tasks = readFileSync(process.argv[2], 'utf8').split('\n').filter(Boolean)
for (const t of tasks) {
  const hits = new Set<string>()
  const r0 = readyPlan(t); if (r0) hits.add(`= ${r0.title}`)
  for (const g of G) for (const a of g) if (t.startsWith(a + ' ')) for (const b of g) if (b !== a) { const r = readyPlan(b + t.slice(a.length)); if (r && !r.corrected) hits.add(`${b + t.slice(a.length)} → ${r.title}`) }
  if (hits.size) console.log(`${t}  ⇒  ${[...hits].join('; ')}`)
}
